# Copy to .env.local for `vercel dev`, and set the same names in
# Vercel → Project → Settings → Environment Variables for production.

# ── Public (bundled into the browser; never put secrets here) ──────────────
VITE_BILLING=on                 # turn on accounts and paywall; omit for an open preview build
VITE_CURRENCY_SYMBOL=£
VITE_CONTACT_EMAIL=

# ── Server only ─────────────────────────────────────────────────────────────
APP_URL=https://your-domain.example         # canonical https origin; used for links and CSRF checks
SESSION_SECRET=                              # 32+ random chars: `openssl rand -base64 48`
STRIPE_SECRET_KEY=sk_live_...                # restricted key: Customers write, Checkout write, Billing portal write, Subscriptions read
STRIPE_PRICE_PRO=price_...                   # monthly £59 price
STRIPE_PRICE_TEAM=price_...                  # monthly £199 price
TRIAL_DAYS=14
RESEND_API_KEY=re_...
EMAIL_FROM=Erlang Desk <signin@your-domain.example>
UPSTASH_REDIS_REST_URL=                      # recommended: shared rate limiting across serverless instances
UPSTASH_REDIS_REST_TOKEN=
